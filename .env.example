# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://velora_user:velora_password@localhost:5432/velora_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT and Session Security
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRATION=7d
SESSION_COOKIE_NAME=velora_session
COOKIE_SECRET=cookie-secret-min-32-chars-long-example

# Password and Lockout
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Platform Economics
PLATFORM_FEE_PERCENTAGE=20
TOKEN_USD_VALUE_MINOR_UNITS=10 # 1 token = $0.10 USD (10 cents)

# Object Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=velora-public-media
S3_BUCKET_PROTECTED=velora-protected-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Sandbox Payment Provider (e.g. CCBill / Segpay / Sandbox)
PAYMENT_PROVIDER_MODE=sandbox
PAYMENT_SANDBOX_WEBHOOK_SECRET=velora_sandbox_webhook_secret_key_12345
PAYMENT_MERCHANT_ID=sandbox_merchant_velora

# Identity & Age Verification Provider
IDENTITY_PROVIDER_MODE=sandbox
IDENTITY_WEBHOOK_SECRET=identity_webhook_secret_test_key

# Streaming Provider (RTMP / WebRTC / Media Server)
STREAMING_PROVIDER_MODE=sandbox
STREAMING_INGEST_BASE_URL=rtmp://localhost:1935/live
STREAMING_PLAYBACK_BASE_URL=http://localhost:8080/hls
STREAMING_WEBHOOK_SECRET=streaming_webhook_secret_key

# 2FA
TWO_FACTOR_APP_NAME="Velora Live"
